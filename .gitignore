# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
*.egg

# ── Virtual environment ──────────────────────────────────────────────
venv/
.venv/
env/
.env

# ── ML / Model weights ──────────────────────────────────────────────
# Large binary model files — download/train separately
*.pt
*.onnx
*.engine
*.tflite
*.pb
runs/          # YOLO training runs
datasets/      # Training datasets (regenerated via train_custom_model.py)
custom_dataset/
custom_training/
Waste/         # Raw training images

# ── Data / Uploads / Evidence ────────────────────────────────────────
data/uploads/
data/evidence/
# Keep data/models/ directory tracked (but not the .pt files inside)
data/models/*.pt

# ── Frontend build ────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.dist/
.dist/

# ── IDE / OS ──────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# ── Secrets / Env ─────────────────────────────────────────────────────
.env
.env.*
*.env

# ── Misc ──────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
